DOMAIN_NAME=rguigneb.42.fr

# MYSQL SETUP
MYSQL_USER=wordpress
MYSQL_DATABASE=wordpress

# WORDPRESS USERS
WP_ADMIN_USER=rguigneb
WP_ADMIN_EMAIL=rguigneb@gmail.com
WP_ADMIN_PASSWORD=admin

WP_SUB_USER=riad
WP_SUB_EMAIL=riad@example.com
WP_SUB_PASSWORD=riadlebg

# N8N SETUP
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=n8n
N8N_BASIC_AUTH_PASSWORD=n8n
N8N_HOST=${DOMAIN_NAME}/n8n/
N8N_PORT=5678
N8N_PATH=/n8n/
N8N_ENCRYPTION_KEY=fqwfqfqfqfqfqfq

# Add these n8n database settings
N8N_DB_TYPE=mariadb
N8N_DB_MYSQLDB_HOST=mariadb
N8N_DB_MYSQLDB_PORT=3306
N8N_DB_MYSQLDB_DATABASE=n8n
N8N_DB_MYSQLDB_USER=n8n_user
N8N_DB_MYSQLDB_PASSWORD=n8n_password
# Add n8n database variables
DB_MYSQLDB_COLLATION=utf8mb4_general_ci
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

N8N_USER_MANAGEMENT_DISABLED=false
N8N_USER_MANAGEMENT_EMAIL=n8n@yourdomain.com
N8N_USER_MANAGEMENT_PASSWORD=yourpassword
N8N_USER_MANAGEMENT_FIRST_NAME=Admin
N8N_USER_MANAGEMENT_LAST_NAME=User
N8N_USER_MANAGEMENT_ROLE=owner

N8N_DB_NAME=n8n
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=n8n_password

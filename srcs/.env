# ───── DOMAIN ─────
DOMAIN_NAME=rguigneb.42.fr

# ───── WORDPRESS ─────
WP_PORT=9000

WP_USER=wordpress
WP_DATABASE=wordpress

# ───── MARIADB ─────
MARIADB_PORT=3306

# ───── REDIS ─────
REDIS_HOST=redis
REDIS_PORT=9001

# ───── NGINX ─────
NGINX_PORT=443

# ───── FTP ─────
FTP_PORT=21
FTP_MIN_PORT=40000
FTP_MAX_PORT=40010

# ───── ADMINER ─────
ADMINER_PORT=1557
ADMINER_DEFAULT_SERVER=mariadb:${MARIADB_PORT}

# ───── STATIC WEBSITE ─────
STATIC_WEBSITE_PORT=1558

# ───── N8N ─────
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=n8n
N8N_BASIC_AUTH_PASSWORD=n8n
N8N_HOST=${DOMAIN_NAME}:${NGINX_PORT}
N8N_PATH=/n8n/
N8N_PORT=1559
N8N_USER_FOLDER=/home/n8n/.n8n

N8N_DB_TYPE=mariadb
N8N_DB_MYSQLDB_HOST=mariadb
N8N_DB_MYSQLDB_PORT=${MARIADB_PORT}
N8N_DB_MYSQLDB_DATABASE=n8n
N8N_DB_MYSQLDB_COLLATION=utf8mb4_general_ci

# ───── VOLUMES ─────
VOLUME_WORDPRESS_PATH=/home/rguigneb/data/wordpress
VOLUME_MARIADB_PATH=/home/rguigneb/data/mariadb
VOLUME_STATIC_PATH=/home/rguigneb/data/static-website
